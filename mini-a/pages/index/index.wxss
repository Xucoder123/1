
.container {
  padding: 20rpx;
}

.code-editor {
  width: 100%;
  height: 300rpx;
  border: 1px solid #ccc;
  padding: 10rpx;
  font-family: monospace;
  margin-bottom: 10rpx;
}

.button-group {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.compile-button {
  background-color: #1aad19;
  color: white;
  padding: 10rpx;
}

.output-section {
  margin-top: 20rpx;
  padding: 10rpx;
  border: 1px solid #eee;
}

.output-content {
  white-space: pre-wrap; /* 保留输出格式 */
  margin-top: 5rpx;
}

.history-section {
  margin-top: 20rpx;
}

.history-list {
  max-height: 200rpx;
}

.history-item {
  padding: 10rpx;
  border-bottom: 1px solid #ddd; /* 补充颜色 */
}

/* 半透明弹窗样式 */
.error-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5); /* 半透明背景 */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.error-popup-content {
  background-color: white;
  padding: 20rpx;
  border-radius: 10rpx;
  text-align: center;
}